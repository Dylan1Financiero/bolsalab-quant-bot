# Copia este archivo como ".env" junto a bot_quant_x10_app.py (o en ~/bot_quant/.env en la VM) y pega tus llaves.
# NUNCA subas el archivo ".env" real ni "firebase-credenciales.json" a GitHub.

# --- Telegram (BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Inteligencia Artificial (Google Gemini / xAI Grok) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
XAI_API_KEY=
XAI_MODEL=grok-4.7

# --- Exchange Gate.io (Producción lectura pública y Testnet de Futuros para órdenes) ---
GATE_API_KEY=
GATE_API_SECRET=
GATE_TESTNET_KEY=
GATE_TESTNET_SECRET=
GATE_TESTNET_HOST=https://api-testnet.gateapi.io/api/v4

# --- Firebase Admin SDK (Firestore en tiempo real) ---
FIREBASE_CREDENTIALS=firebase-credenciales.json
